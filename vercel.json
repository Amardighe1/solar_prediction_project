{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "installCommand": "echo \"No install needed for static frontend\"",
  "buildCommand": "echo \"Static frontend build complete\"",
  "rewrites": [
    {
      "source": "/static/:path*",
      "destination": "/web/static/:path*"
    },
    {
      "source": "/factors",
      "destination": "/web/factors.html"
    },
    {
      "source": "/",
      "destination": "/web/index.html"
    }
  ]
}

